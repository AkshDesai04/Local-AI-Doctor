# Copy this file to .env and keep the local copy uncommitted.
# Use the Linux-visible path from inside the selected WSL distribution.
MODEL_PATH=/path/to/models
APP_CONFIG_PATH=./config/local.example.yaml

# The PowerShell wrapper uses these values. Leave the distribution empty to
# auto-select the default WSL2 distribution. Leave the user empty to use that
# distribution's configured default Linux user.
WSL_DISTRIBUTION=
WSL_USER=

COMPOSE_PROJECT_NAME=local-ai-doctor
CPU_IMAGE_NAME=local-ai-doctor-cpu
NVIDIA_IMAGE_NAME=local-ai-doctor-nvidia
FRONTEND_IMAGE_NAME=local-ai-doctor-frontend
IMAGE_TAG=dev
CPU_CONTAINER_NAME=local-ai-doctor-cpu
NVIDIA_CONTAINER_NAME=local-ai-doctor-nvidia
CPU_FRONTEND_CONTAINER_NAME=local-ai-doctor-frontend-cpu
NVIDIA_FRONTEND_CONTAINER_NAME=local-ai-doctor-frontend-nvidia

# Container ports are deliberately fixed: UI 6969 and API/WebSocket 6767.
# Both are published on host loopback and are not configurable through .env.
# Compose starts the UI only after backend health succeeds plus a fixed 16-second hold.
UVICORN_WORKERS=1
MODEL_WORKERS=1
CPU_THREADS=8
SHUTDOWN_GRACE_SECONDS=20
STOP_GRACE_PERIOD=30s

# Compose-enforced process limits. Set these for the host being used.
CONTAINER_CPUS=8.0
CONTAINER_MEMORY_LIMIT=16g
CONTAINER_MEMORY_RESERVATION=2g
CONTAINER_PIDS_LIMIT=512
TMPFS_SIZE=1g

# Persistent volume names make upgrades and project renames explicit.
DATABASE_VOLUME_NAME=local-ai-doctor-database
UPLOADS_VOLUME_NAME=local-ai-doctor-uploads
CACHE_VOLUME_NAME=local-ai-doctor-cache
EXPORTS_VOLUME_NAME=local-ai-doctor-exports
BACKUPS_VOLUME_NAME=local-ai-doctor-backups

# The NVIDIA service honors standard Container Toolkit device selection.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
